{
  "USER": {
    "NICKNAME": {
      "MIN": 3,
      "MAX": 30,
      "REGEX": "^[a-zA-Z0-9_]+$",
      "ERROR_MSG": "Nickname can only contain Latin letters, numbers, and '_'"
    },
    "EMAIL": {
      "MAX": 100,
      "REGEX": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
      "ERROR_MSG": "Please enter a valid email address"
    },
    "PASSWORD": {
      "MIN": 8,
      "MAX": 128,
      "REGEX": "^(?=.*[A-Za-z])(?=.*\\d)[A-Za-z\\d@$!%*?&]{8,}$",
      "ERROR_MSG": "Password must be at least 8 chars, contain a letter and a number"
    },
    "DISPLAY_NAME": { "MIN": 2, "MAX": 50 },
    "BIO": { "MAX": 500 },
    "LOCATION": { "MAX": 60 },
    "SOCIAL": { "MAX": 255 },
    "AVATAR": { "MAX": 500 }
  },
  "ARTWORK": {
    "TITLE": { "MIN": 1, "MAX": 100 },
    "DESCRIPTION": { "MAX": 2000 }
  },
  "COLLECTION": {
    "TITLE": { "MIN": 1, "MAX": 60 },
    "DESCRIPTION": { "MAX": 1000 },
    "CONTEXT_DESC": { "MAX": 500 }
  },
  "STICKY_NOTE": {
    "TITLE": { "MAX": 100 },
    "CONTENT": { "MAX": 1000 }
  },
  "DICT": {
    "NAME": { "MAX": 50 }
  },
  "NOTE": {
    "CONTENT": { "MAX": 10000 }
  },
  "CAT_QUOTE": {
    "CONTENT": { "MAX": 500 }
  }
}